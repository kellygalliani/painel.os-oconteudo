NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só para scripts/ (nunca usar em src/)
SUPABASE_SERVICE_ROLE_KEY=
# Cloudflare R2 (vídeos brutos). Só servidor: nunca NEXT_PUBLIC_.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=os-oconteudo-videos
# Zernio (postar no Instagram e no TikTok). Só servidor: nunca NEXT_PUBLIC_.
ZERNIO_API_KEY=
# Segredo do aviso de comentários do Zernio (npm run zernio:aviso). Só servidor.
ZERNIO_WEBHOOK_SECRET=
